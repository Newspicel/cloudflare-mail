{
  "name": "@cfmail/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "wrangler d1 migrations apply cfmail --config ../../apps/worker/wrangler.jsonc",
    "migrate:local": "wrangler d1 migrations apply cfmail --local --config ../../apps/worker/wrangler.jsonc",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260623.1",
    "@typescript/native-preview": "7.0.0-dev.20260623.1",
    "drizzle-kit": "0.31.10",
    "wrangler": "4.104.0"
  }
}
