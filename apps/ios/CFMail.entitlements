<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app publish verification codes to the AutoFill identity store. -->
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<!-- Shared with the AutoFill extension; how a code reaches the QuickType bar
	     without an app group. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.newspicel.cfmail.shared</string>
	</array>
</dict>
</plist>
