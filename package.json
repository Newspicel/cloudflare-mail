{
  "name": "cloudflare-mail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "deploy": "turbo run build --filter=@cfmail/worker && pnpm --filter @cfmail/db migrate --remote && pnpm --filter @cfmail/worker exec wrangler deploy",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint && biome check .",
    "lint:fix": "oxlint --fix && biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @cfmail/db generate",
    "db:migrate": "pnpm --filter @cfmail/db migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "oxlint": "1.82.0",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
